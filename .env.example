# ==============================================================
# البوابة الرقمية لمدرسة أرمنا الثانوية المشتركة - ملف المتغيرات
# Armana Secondary School Digital Portal - Environment Variables
# ==============================================================

# منفذ تشغيل الخادم (الافتراضي: 3000)
PORT=3000

# بيئة التشغيل (development أو production)
NODE_ENV=development

# مفتاح الذكاء الاصطناعي Google Gemini API للمساعد الذكي للمدرسة (اختياري، يعمل بنظام الرد الذكي المدمج في حال عدم توفره)
# يمكنك الحصول على المفتاح من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
